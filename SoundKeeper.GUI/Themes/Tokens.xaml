<!-- Golabox Utility System v1.0 — design tokens (handoff I.1). Values only, no colors:
     colors are Windows ThemeResources consumed by name (handoff I.2). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Espacement : grille de 4 epx -->
    <x:Double x:Key="SpaceXXS">4</x:Double>
    <x:Double x:Key="SpaceXS">8</x:Double>
    <x:Double x:Key="SpaceS">12</x:Double>
    <x:Double x:Key="SpaceM">16</x:Double>
    <x:Double x:Key="SpaceL">24</x:Double>
    <x:Double x:Key="SpaceXL">32</x:Double>
    <x:Double x:Key="SpaceXXL">48</x:Double>
    <!-- Page -->
    <Thickness x:Key="PagePaddingDefault">24,24,24,32</Thickness>
    <Thickness x:Key="PagePaddingCompact">12,24,12,32</Thickness>
    <x:Double x:Key="ContentMaxWidth">1064</x:Double>
    <Thickness x:Key="PageHeaderMargin">0,0,0,24</Thickness>
    <!-- Sections et lignes -->
    <Thickness x:Key="SectionMargin">0,24,0,0</Thickness>
    <Thickness x:Key="SectionHeaderMargin">0,0,0,8</Thickness>
    <x:Double x:Key="RowGap">4</x:Double>
    <Thickness x:Key="RowPadding">16,12,16,12</Thickness>
    <x:Double x:Key="RowMinHeight">60</x:Double>
    <x:Double x:Key="RowMinHeightDense">44</x:Double>
    <x:Double x:Key="IconTextGap">16</x:Double>
    <x:Double x:Key="ControlGap">16</x:Double>
    <x:Double x:Key="ButtonGroupGap">8</x:Double>
    <!-- Géométrie : alignée sur WinUI, rien d'inventé -->
    <CornerRadius x:Key="RadiusCard">4</CornerRadius>
    <x:Double x:Key="BorderThin">1</x:Double>
    <!-- ControlCornerRadius = 4 et OverlayCornerRadius = 8 sont déjà système -->
    <!-- Contrôles -->
    <x:Double x:Key="ControlHeight">32</x:Double>
    <x:Double x:Key="ControlWidthSelect">200</x:Double>
    <x:Double x:Key="ControlWidthSelectWide">280</x:Double>
    <x:Double x:Key="ButtonMinWidth">120</x:Double>
    <x:Double x:Key="IconButtonSize">32</x:Double>
    <!-- Icônes -->
    <x:Double x:Key="IconInline">16</x:Double>
    <x:Double x:Key="IconRow">20</x:Double>
    <x:Double x:Key="IconStatus">12</x:Double>
    <x:Double x:Key="IconAbout">48</x:Double>
    <!-- Flyout de zone de notification -->
    <x:Double x:Key="FlyoutWidth">360</x:Double>
    <x:Double x:Key="FlyoutMinWidth">320</x:Double>
    <x:Double x:Key="FlyoutMaxHeight">480</x:Double>
    <Thickness x:Key="FlyoutPadding">8</Thickness>
    <x:Double x:Key="FlyoutRowHeight">68</x:Double>
    <x:Double x:Key="FlyoutHeaderHeight">40</x:Double>
    <!-- Fenêtre -->
    <x:Double x:Key="WindowMinWidth">480</x:Double>
    <x:Double x:Key="WindowMinHeight">560</x:Double>

    <!-- Additions from the Phase D token table (not part of handoff I.1), needed by Shell B. -->
    <!-- Responsive : BpCompact < 640, BpMedium 640 – 1007, BpWide >= 1008 -->
    <x:Double x:Key="BpCompact">640</x:Double>
    <x:Double x:Key="BpWide">1008</x:Double>
    <!-- NavigationView expanded pane width (Phase C, navModes) -->
    <x:Double x:Key="NavPaneWidth">260</x:Double>
    <!-- TypeMono 13 / 20 : logs, paths, commands, diagnostic only -->
    <x:Double x:Key="MonoFontSize">13</x:Double>
</ResourceDictionary>
