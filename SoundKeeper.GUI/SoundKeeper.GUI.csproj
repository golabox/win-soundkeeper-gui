<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SoundKeeper.GUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\soundkeeper.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)\publish\$(RuntimeIdentifier)\</PublishDir>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <LangVersion>latest</LangVersion>
    <!-- Single version source: About, AssemblyVersion, FileVersion and ProductVersion (no +commit suffix). -->
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>SoundKeeper.GUI</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window (AppWindow.SetIcon), notification area (TrayIconService) and About icons, loaded from disk next to the executable. -->
    <Content Include="Assets\soundkeeper.ico;Assets\soundkeeper-tray.ico;Assets\soundkeeper-app.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySoundKeeperEngine" AfterTargets="Build">
    <PropertyGroup>
      <EngineFile Condition="'$(Platform)' == 'x64'">$(MSBuildProjectDirectory)\..\Bin\SoundKeeper64.exe</EngineFile>
      <EngineFile Condition="'$(Platform)' == 'ARM64'">$(MSBuildProjectDirectory)\..\Bin\SoundKeeperARM64.exe</EngineFile>
    </PropertyGroup>
    <Warning Condition="!Exists('$(EngineFile)')" Text="Moteur Sound Keeper introuvable ($(EngineFile)) : compiler d'abord SoundKeeper.vcxproj en Release|$(Platform). Le GUI est produit sans dossier Engine." />
    <MakeDir Directories="$(OutDir)Engine" Condition="Exists('$(EngineFile)')" />
    <Copy SourceFiles="$(EngineFile)" DestinationFolder="$(OutDir)Engine" SkipUnchangedFiles="true" Condition="Exists('$(EngineFile)')" />
  </Target>

  <Target Name="CopyLocalizationResources" AfterTargets="Build">
    <ItemGroup>
      <LocalizationResource Include="$(MSBuildProjectDirectory)\Strings\**\Resources.resw" />
    </ItemGroup>
    <Copy
      SourceFiles="@(LocalizationResource)"
      DestinationFiles="@(LocalizationResource->'$(TargetDir)Strings\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWinUiResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <!-- One compiled .xbf per XAML file of the project (App.xaml, windows, Themes\*.xaml...), at its relative path. -->
      <XamlPublishSource Include="@(ApplicationDefinition);@(Page)" />
      <EnginePublishResource Include="$(TargetDir)Engine\*" />
      <LocalizationPublishResource Include="$(MSBuildProjectDirectory)\Strings\**\Resources.resw" />
    </ItemGroup>
    <Copy
      SourceFiles="@(XamlPublishSource->'$(TargetDir)%(RelativeDir)%(Filename).xbf')"
      DestinationFiles="@(XamlPublishSource->'$(PublishDir)%(RelativeDir)%(Filename).xbf')"
      SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(PublishDir)Engine" Condition="'@(EnginePublishResource)' != ''" />
    <Copy SourceFiles="@(EnginePublishResource)" DestinationFolder="$(PublishDir)Engine" SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(LocalizationPublishResource)"
      DestinationFiles="@(LocalizationPublishResource->'$(PublishDir)Strings\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Marks the published folder as the stable build targeted by Windows startup (StartupService.PublishedMarkerFileName). -->
  <Target Name="MarkPublishedBuild" AfterTargets="Publish">
    <WriteLinesToFile
      File="$(PublishDir)$(AssemblyName).published"
      Lines="Published build: target of the Windows startup entry."
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
